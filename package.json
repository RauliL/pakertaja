{
  "name": "pakertaja",
  "description": "Tiny JavaScript library for building HTML elements",
  "version": "3.0.0",
  "type": "module",
  "author": "Rauli Laine",
  "homepage": "https://rauli.dev/pakertaja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:RauliL/pakertaja.git"
  },
  "bugs": {
    "url": "https://github.com/RauliL/pakertaja/issues"
  },
  "keywords": [
    "dom"
  ],
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/pakertaja.mjs",
      "default": "./dist/pakertaja.mjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "clean": "rimraf './dist'",
    "prebuild": "$npm_execpath run clean",
    "prepack": "$npm_execpath run build",
    "lint": "eslint",
    "style:check": "prettier --check .",
    "style:fix": "prettier --write .",
    "types:check": "npx check-dts",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.8.9",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "terser": "^5.51.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.d.ts",
    "dist/pakertaja.mjs"
  ],
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
